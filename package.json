{
  "name": "flux-mobile",
  "version": "0.0.1",
  "private": true,
  "description": "An Ionic project",
  "homepage": "https://ionicframework.com/",
  "author": "Ionic Framework",
  "scripts": {
    "android": "ionic cap run android -c development",
    "android:prod": "ionic cap run android -c production",
    "android:staging": "ionic cap run android -c staging",
    "api:generate": "openapi-ts",
    "prebuild": "node scripts/write-build-info.mjs",
    "build": "ng build",
    "prebuild:dev": "node scripts/write-build-info.mjs",
    "build:dev": "ng build -c development",
    "prebuild:staging": "node scripts/write-build-info.mjs",
    "build:staging": "ng build -c staging",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/write-build-info.mjs",
    "ionic:build:before": "node scripts/write-build-info.mjs",
    "ionic:serve:before": "node scripts/write-build-info.mjs",
    "ios": "ionic cap run ios -c development",
    "ios:prod": "ionic cap run ios -c production",
    "ios:staging": "ionic cap run ios -c staging",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "ng": "ng",
    "prepare": "husky",
    "prestart": "node scripts/write-build-info.mjs",
    "start": "ng serve",
    "prestart:staging": "node scripts/write-build-info.mjs",
    "start:staging": "ng serve -c staging",
    "sync": "ionic cap sync",
    "pretest": "node scripts/write-build-info.mjs",
    "test": "ng test",
    "pretest:coverage": "node scripts/write-build-info.mjs",
    "test:coverage": "ng test --coverage --watch=false",
    "watch": "ng build --watch --configuration development"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": "eslint --fix",
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@angular/common": "22.0.1",
    "@angular/compiler": "22.0.1",
    "@angular/core": "22.0.1",
    "@angular/forms": "22.0.1",
    "@angular/platform-browser": "22.0.1",
    "@angular/router": "22.0.1",
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/angular": "^9.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.0.1",
    "@angular/cli": "22.0.1",
    "@angular/compiler-cli": "22.0.1",
    "@angular/language-service": "22.0.1",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.5",
    "@hey-api/openapi-ts": "0.99.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/cli": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.0.0",
    "eslint": "^9.16.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.0": true,
    "esbuild@0.27.7": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true
  }
}
