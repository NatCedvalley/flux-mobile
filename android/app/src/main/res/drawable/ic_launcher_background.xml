<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon's gradient (resources/icon/icon-ios.svg). It runs across the
     72dp the launcher shows (18 to 90), as it runs across the iOS tile. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0" android:color="#FF3E63DD" />
                <item android:offset="1" android:color="#FF6E56CF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
